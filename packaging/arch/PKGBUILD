# Paquete local para Arch / CachyOS, compilado desde esta copia del código.
# Genera dos paquetes (instalar solo uno, se excluyen entre sí):
#   neontop         → x86-64 genérico: funciona en cualquier PC de 64 bits.
#   neontop-native  → optimizado para la CPU de la máquina donde se compila
#                     (target-cpu=native). En otras CPUs puede dar SIGILL.
# Todo es Rust: la interfaz (GPUI), el lector de tráfico de RAM y la capa de FPS (Vulkan y
# OpenGL, 64 y 32 bits). Para la capa de 32 bits hace falta la biblioteca estándar de Rust para
# i686: con rustup, `rustup target add i686-unknown-linux-gnu`; con el paquete rust, lib32-rust-libs.
# Uso:  cd packaging/arch && makepkg -f
#       sudo pacman -U neontop-<ver>-x86_64.pkg.tar.zst          (general)
#       sudo pacman -U neontop-native-<ver>-x86_64.pkg.tar.zst   (nativo)
pkgbase=neontop
pkgname=('neontop' 'neontop-native')
pkgver=0.14.0
pkgrel=1
pkgdesc="Monitor de recursos del sistema con estética neón (CPU, memoria, red, procesos, discos, sensores, GPU, energía y FPS de juegos)"
arch=('x86_64')
license=('MIT')
depends=('vulkan-icd-loader' 'wayland' 'libxkbcommon' 'libxkbcommon-x11' 'libxcb' 'hwdata' 'polkit' 'libcap')
optdepends=(
  'apcupsd: consumo total del puesto con un SAI APC'
  'nvidia-utils: métricas de GPUs NVIDIA (NVML)'
  'lm_sensors: detectar sensores de placa base (sensors-detect)'
  'lib32-vulkan-icd-loader: medir FPS en juegos Vulkan de 32 bits'
)
makedepends=('rust' 'cargo' 'lib32-glibc' 'lib32-gcc-libs')
options=('!lto' '!debug')

_src="$startdir/../.."

prepare() {
  if ! rustc --print target-libdir --target i686-unknown-linux-gnu >/dev/null 2>&1 || [ ! -d "$(rustc --print target-libdir --target i686-unknown-linux-gnu)" ]; then
    error "Falta la biblioteca estándar de Rust para i686 (capa de FPS de 32 bits)."
    plain "Con rustup: rustup target add i686-unknown-linux-gnu · con el paquete rust: lib32-rust-libs"
    return 1
  fi
}

build() {
  cd "$_src"
  # makepkg (sobre todo en CachyOS) trae target-cpu=native en RUSTFLAGS: se fija en cada variante
  unset RUSTFLAGS CFLAGS CXXFLAGS
  # capa de FPS y lanzador (64 y 32 bits) y lector de tráfico de RAM: x86-64 genérico en ambos paquetes
  RUSTFLAGS="-C target-cpu=x86-64" cargo build --release --locked --target-dir target/pkg-common \
    -p neontop-layer -p neontop-gl -p neontop-fps -p neontop-membw
  # 32 bits: la CPU base del objetivo (pentium4, con SSE2, que exige su ABI)
  cargo build --release --locked --target-dir target/pkg-common \
    --target i686-unknown-linux-gnu -p neontop-layer -p neontop-gl
  # la interfaz, en sus dos variantes
  RUSTFLAGS="-C target-cpu=x86-64" cargo build --release --locked --target-dir target/pkg-generic -p neontop
  RUSTFLAGS="-C target-cpu=native" cargo build --release --locked --target-dir target/pkg-native -p neontop
}

check() {
  cd "$_src"
  cargo test --release --locked --target-dir target/pkg-common -p neontop-core -p neontop-fps-shm -p neontop-fps
}

_install_common() { # $1 = variante
  cd "$_src"
  local C=target/pkg-common/release C32=target/pkg-common/i686-unknown-linux-gnu/release
  install -Dm755 "target/pkg-$1/release/neontop" "$pkgdir/usr/bin/neontop"
  install -Dm755 $C/neontop-fps "$pkgdir/usr/bin/neontop-fps"
  install -Dm755 $C/neontop-membw "$pkgdir/usr/lib/neontop/neontop-membw"
  install -Dm644 packaging/neontop.desktop "$pkgdir/usr/share/applications/neontop.desktop"
  install -Dm644 packaging/60-neontop-rapl.rules "$pkgdir/usr/share/neontop/60-neontop-rapl.rules"
  # acciones de administrador con pkexec: la contraseña se recuerda unos minutos
  install -Dm644 packaging/com.neontop.app.policy "$pkgdir/usr/share/polkit-1/actions/com.neontop.app.policy"
  # medición de FPS: capa Vulkan implícita (solo con NEONTOP_FPS=1) y precarga OpenGL, 64 y 32 bits
  install -Dm755 $C/libneontop_layer.so "$pkgdir/usr/lib/neontop/libneontop_layer.so"
  install -Dm755 $C/libneontop_gl.so "$pkgdir/usr/lib/neontop/libneontop_gl.so"
  install -Dm755 $C32/libneontop_layer.so "$pkgdir/usr/lib32/neontop/libneontop_layer.so"
  install -Dm755 $C32/libneontop_gl.so "$pkgdir/usr/lib32/neontop/libneontop_gl.so"
  install -Dm644 packaging/layer/neontop_fps.x86_64.json "$pkgdir/usr/share/vulkan/implicit_layer.d/neontop_fps.x86_64.json"
  install -Dm644 packaging/layer/neontop_fps.x86.json "$pkgdir/usr/share/vulkan/implicit_layer.d/neontop_fps.x86.json"
  install -Dm644 assets/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/neontop.png"
  install -Dm644 assets/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/neontop.png"
  install -Dm644 assets/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/neontop.png"
  install -Dm644 app-icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/neontop.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/fonts/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/FUENTES.txt"
}

package_neontop() {
  install=neontop.install
  conflicts=('neontop-native')
  _install_common generic
}

package_neontop-native() {
  install=neontop.install
  pkgdesc+=" — compilado para la CPU de esta máquina"
  provides=("neontop=$pkgver")
  conflicts=('neontop')
  _install_common native
}
